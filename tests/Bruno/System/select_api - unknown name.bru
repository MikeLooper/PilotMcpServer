meta {
  name: select_api - unknown name
  type: http
  seq: 12
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 14,
    "method": "tools/call",
    "params": {
      "name": "select_api",
      "arguments": {
        "apiName": "No Such API"
      }
    }
  }
}

tests {
  test("returns a tool error", function () {
    expect(res.getBody().result.isError).to.equal(true);
    expect(res.getBody().result.content[0].text).to.include("Unknown Pilot API");
  });
}
