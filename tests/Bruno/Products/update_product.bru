meta {
  name: update_product
  type: http
  seq: 6
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 58,
    "method": "tools/call",
    "params": {
      "name": "update_product",
      "arguments": {
        "product": {
          "productName": "Bruno Updated",
          "quantityPerUnit": "1 box",
          "discontinued": true,
          "productId": {{productId}}
        },
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getBody().result.isError).to.not.equal(true);
  });
}
