meta {
  name: get_all_order_details
  type: http
  seq: 3
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 82,
    "method": "tools/call",
    "params": {
      "name": "get_all_order_details",
      "arguments": {
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("returns records with their composite key", function () {
    const records = res.getBody().tool;
    expect(records).to.be.an("array").that.is.not.empty;
    expect(records[0]).to.include.keys("orderId", "productId");
  });
}
