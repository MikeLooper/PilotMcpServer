meta {
  name: update_category
  type: http
  seq: 6
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 22,
    "method": "tools/call",
    "params": {
      "name": "update_category",
      "arguments": {
        "category": {
          "categoryName": "Bruno Updated",
          "description": "Updated by Bruno",
          "categoryId": {{categoryId}}
        },
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getBody().result.isError).to.not.equal(true);
  });
}
