meta {
  name: update_customer
  type: http
  seq: 6
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 31,
    "method": "tools/call",
    "params": {
      "name": "update_customer",
      "arguments": {
        "customer": {
          "customerId": "{{customerId}}",
          "companyName": "Bruno Updated",
          "city": "Seattle",
          "country": "USA"
        },
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getBody().result.isError).to.not.equal(true);
  });
}
