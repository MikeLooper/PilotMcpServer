meta {
  name: update_order_detail
  type: http
  seq: 8
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 87,
    "method": "tools/call",
    "params": {
      "name": "update_order_detail",
      "arguments": {
        "orderDetail": {
          "orderId": {{lineOrderId}},
          "productId": {{lineProductId}},
          "unitPrice": 9.5,
          "quantity": 7,
          "discount": 0.25
        },
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("succeeds", function () {
    expect(res.getBody().result.isError).to.not.equal(true);
  });
}
