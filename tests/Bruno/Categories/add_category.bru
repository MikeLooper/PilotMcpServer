meta {
  name: add_category
  type: http
  seq: 4
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 20,
    "method": "tools/call",
    "params": {
      "name": "add_category",
      "arguments": {
        "category": {
          "categoryName": "Bruno Test",
          "description": "Created by Bruno"
        },
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("returns the new ID", function () {
    const id = res.getBody().tool.id;
    expect(id).to.be.a("number").that.is.above(0);
    bru.setVar("categoryId", id);
  });
}
