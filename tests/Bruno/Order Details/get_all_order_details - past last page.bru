  {
    "jsonrpc": "2.0",
    "id": 84,
    "method": "tools/call",
    "params": {
      "name": "get_all_order_details",
      "arguments": {
        "page": 999999,
        "pageSize": 2,
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("returns no records", function () {
    expect(res.getBody().tool).to.deep.equal([]);
  });
}
