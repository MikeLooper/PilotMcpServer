meta {
  name: get_customer - after add
  type: http
  seq: 5
}

post {
  url: {{mcpUrl}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 30,
    "method": "tools/call",
    "params": {
      "name": "get_customer",
      "arguments": {
        "customerId": "{{customerId}}",
        "apiName": "{{apiName}}"
      }
    }
  }
}

tests {
  test("returns the expected record", function () {
    const record = res.getBody().tool;
    expect(String(record.customerId)).to.equal(String(bru.getVar("customerId")));
    expect(record.companyName).to.equal("Bruno Test");
    expect(record.city).to.equal("Portland");
  });
}
